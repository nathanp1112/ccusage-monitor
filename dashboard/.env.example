# API Server URL (server-side, proxied via Next.js rewrites)
# Profiles:
#   Local (legacy):  http://localhost:3003
#   LAN (legacy):    http://192.168.0.193:3003
#   Lambda (dev):    https://5kvqadz4mc.execute-api.ap-southeast-1.amazonaws.com
API_SERVER_URL=http://localhost:3003

# Direct API URL for static export (client-side)
# Use this when deploying as static site (S3, Vercel, Netlify)
# Leave empty when using Next.js server with rewrites
NEXT_PUBLIC_API_URL=

# App Name (optional)
NEXT_PUBLIC_APP_NAME=CCUsage Team Monitor
