direction: right

# ──────────────────────────────────────────
# Force Mode (top-level note)
# ──────────────────────────────────────────
ForceMode: "Force Mode\n(ccusage-agent sync --force)" {
  style: {
    fill: "#ffebee"
    stroke: "#c62828"
    stroke-width: 2
    stroke-dash: 5
    font-size: 13
    bold: true
    border-radius: 10
  }
  reset: "Reset ALL file_offsets = {}\nEvery file treated as NEW" {
    style.fill: "#ffcdd2"
    style.stroke: "#c62828"
    style.border-radius: 8
    style.font-size: 12
  }
}

# ──────────────────────────────────────────
# Main State Machine
# ──────────────────────────────────────────
start: "For each\n.jsonl file" {
  shape: oval
  style.fill: "#e8f4fd"
  style.stroke: "#1565c0"
  style.font-size: 13
}

CheckFile: "Check\nfile_offsets[file]" {
  shape: diamond
  style.fill: "#fff3e0"
  style.stroke: "#e65100"
  style.font-size: 12
}

# ── Branch: New File ──
NewFile: "NEW FILE\nbyteOffset = 0" {
  style.fill: "#c8e6c9"
  style.stroke: "#2e7d32"
  style.border-radius: 8
  style.font-size: 12
}
ReadAll: "Read entire file\ncreateReadStream(start: 0)" {
  style.fill: "#dcedc8"
  style.stroke: "#558b2f"
  style.border-radius: 8
  style.font-size: 12
}

# ── Branch: Existing File ──
ExistingFile: "EXISTING FILE\nCompare sizes" {
  style: {
    fill: "#fff8e1"
    stroke: "#f57f17"
    stroke-width: 2
    font-size: 13
    bold: true
    border-radius: 10
  }

  CompareSize: "stat(file).size\nvs offset" {
    shape: diamond
    style.fill: "#fff8e1"
    style.stroke: "#f57f17"
    style.font-size: 12
  }

  # ── size == offset ──
  Unchanged: "SAME SIZE\nsize == offset" {
    style.fill: "#e0e0e0"
    style.stroke: "#616161"
    style.border-radius: 8
    style.font-size: 12
  }
  FpCheckSame: "Verify fingerprint\nSHA-256(first 512 bytes)\nvs stored hash" {
    shape: diamond
    style.fill: "#e1bee7"
    style.stroke: "#6a1b9a"
    style.font-size: 11
  }
  SkipFile: "SKIP\nZero I/O\n(most common path)" {
    style.fill: "#e0e0e0"
    style.stroke: "#616161"
    style.border-radius: 8
    style.font-size: 11
    style.italic: true
  }
  ReplacedSame: "FILE REPLACED\n(same size, different content)\nReset offset = 0" {
    style.fill: "#ffcdd2"
    style.stroke: "#c62828"
    style.border-radius: 8
    style.font-size: 11
  }

  # ── size > offset ──
  Appended: "LARGER\nsize > offset" {
    style.fill: "#c8e6c9"
    style.stroke: "#2e7d32"
    style.border-radius: 8
    style.font-size: 12
  }
  FpCheckGrown: "Verify fingerprint\nSHA-256(first 512 bytes)\nvs stored hash" {
    shape: diamond
    style.fill: "#e1bee7"
    style.stroke: "#6a1b9a"
    style.font-size: 11
  }
  ReadIncremental: "Read from offset\ncreateReadStream(start: offset)\nSame file, appended" {
    style.fill: "#dcedc8"
    style.stroke: "#558b2f"
    style.border-radius: 8
    style.font-size: 12
  }
  ReplacedLarger: "FILE REPLACED\n(larger, different head)\nReset offset = 0" {
    style.fill: "#ffcdd2"
    style.stroke: "#c62828"
    style.border-radius: 8
    style.font-size: 11
  }

  # ── size < offset ──
  Truncated: "TRUNCATED\nsize < offset" {
    style.fill: "#ffcdd2"
    style.stroke: "#c62828"
    style.border-radius: 8
    style.font-size: 12
  }
  ResetAndRead: "Reset offset = 0\nRe-read entire file" {
    style.fill: "#ffcdd2"
    style.stroke: "#c62828"
    style.border-radius: 8
    style.font-size: 12
  }

  # ── Size comparison ──
  CompareSize -> Unchanged: "=="
  CompareSize -> Appended: ">"
  CompareSize -> Truncated: "<"

  # ── Same size path ──
  Unchanged -> FpCheckSame
  FpCheckSame -> SkipFile: "match"
  FpCheckSame -> ReplacedSame: "mismatch"

  # ── Larger path ──
  Appended -> FpCheckGrown
  FpCheckGrown -> ReadIncremental: "match"
  FpCheckGrown -> ReplacedLarger: "mismatch"

  # ── Truncated path ──
  Truncated -> ResetAndRead
}

# ── Parse Lines ──
ParseLines: "Parse JSONL Lines" {
  style: {
    fill: "#e8f4fd"
    stroke: "#1565c0"
    stroke-width: 2
    font-size: 13
    bold: true
    border-radius: 10
  }

  ReadLine: "Read line" {
    style.fill: "#e8f4fd"
    style.stroke: "#1565c0"
    style.border-radius: 8
    style.font-size: 12
  }
  ParseJSON: "JSON.parse(line)" {
    style.fill: "#e8f4fd"
    style.stroke: "#1565c0"
    style.border-radius: 8
    style.font-size: 12
  }
  ExtractUsage: "Has message.usage?\n→ UsageEntry\nPush to entries[]" {
    style.fill: "#c8e6c9"
    style.stroke: "#2e7d32"
    style.border-radius: 8
    style.font-size: 11
  }
  ExtractPrompt: "type == 'user'?\n→ PromptEntry\nPush to prompts[]" {
    style.fill: "#c8e6c9"
    style.stroke: "#2e7d32"
    style.border-radius: 8
    style.font-size: 11
  }
  SkipLine: "Incomplete\nNo usage data\n→ skip" {
    style.fill: "#e0e0e0"
    style.stroke: "#616161"
    style.border-radius: 8
    style.font-size: 11
  }
  EOF: "EOF" {
    shape: oval
    style.fill: "#e8f4fd"
    style.stroke: "#1565c0"
    style.font-size: 12
  }

  ReadLine -> ParseJSON
  ParseJSON -> ExtractUsage: "yes"
  ParseJSON -> ExtractPrompt: "user msg"
  ParseJSON -> SkipLine: "no"
  ExtractUsage -> ReadLine
  ExtractPrompt -> ReadLine
  SkipLine -> ReadLine
  ReadLine -> EOF: "no more lines"
}

# ── Save & Done ──
SaveOffset: "Save offset + fingerprint\nfile_offsets[file] = {\n  byteOffset: fileSize,\n  fingerprint: SHA-256(head)\n}" {
  style.fill: "#c8e6c9"
  style.stroke: "#2e7d32"
  style.border-radius: 8
  style.font-size: 12
}
Done: "Done\n→ next file" {
  shape: oval
  style.fill: "#c8e6c9"
  style.stroke: "#2e7d32"
  style.font-size: 12
}

# ──────────────────────────────────────────
# Connections
# ──────────────────────────────────────────
start -> CheckFile
CheckFile -> NewFile: "No offset\nin state"
CheckFile -> ExistingFile.CompareSize: "Has offset\nin state"

NewFile -> ReadAll
ReadAll -> ParseLines.ReadLine
ExistingFile.ReadIncremental -> ParseLines.ReadLine
ExistingFile.ResetAndRead -> ParseLines.ReadLine
ExistingFile.ReplacedSame -> ParseLines.ReadLine: "re-read all"
ExistingFile.ReplacedLarger -> ParseLines.ReadLine: "re-read all"

ParseLines.EOF -> SaveOffset
ExistingFile.SkipFile -> Done
SaveOffset -> Done

ForceMode -> start: "all files become NEW" {
  style.stroke-dash: 5
  style.stroke: "#c62828"
}
