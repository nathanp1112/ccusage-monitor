shape: sequence_diagram

OS: "launchd / systemd" {
  style: {
    fill: "#e0f2f1"
    stroke: "#00695c"
    font-size: 13
  }
}
D: "daemon.ts" {
  style: {
    fill: "#fff8e1"
    stroke: "#f57f17"
    font-size: 13
  }
}
Cfg: "config.ts" {
  style: {
    fill: "#fff3e0"
    stroke: "#e65100"
    font-size: 13
  }
}
Col: "collector.ts" {
  style: {
    fill: "#fff3e0"
    stroke: "#e65100"
    font-size: 13
  }
}
P: "pricing.ts" {
  style: {
    fill: "#fff3e0"
    stroke: "#e65100"
    font-size: 13
  }
}
Push: "pusher.ts" {
  style: {
    fill: "#fff3e0"
    stroke: "#e65100"
    font-size: 13
  }
}
Cmd: "commander.ts" {
  style: {
    fill: "#fff3e0"
    stroke: "#e65100"
    font-size: 13
  }
}
