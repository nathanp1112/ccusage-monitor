{
  "name": "ccusage-agent",
  "version": "0.5.0",
  "description": "Agent for collecting and syncing Claude Code usage data",
  "type": "module",
  "bin": {
    "ccusage-agent": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
